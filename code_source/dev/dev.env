# Local development mode variables (no secrets, checked by dev/check_env.py) — loaded by dev/run_server.sh
# and to be sourced before dev/seed/seed_emulator.py:  set -a && source dev/dev.env && set +a
ALJ_ENV=dev
ALJ_API_AUTH=off
MEMBER_BACKEND=firestore
ALJ_DATA_DIR=./data-dev
FIRESTORE_EMULATOR_HOST=localhost:8081
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# E-mails: the application's SMTP points to Mailpit (dev/docker-compose.yml), nothing leaves the machine
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dev
SMTP_PASSWORD=dev
SMTP_FROM_EMAIL=bureau@poudlard.example
# Empty on purpose: the Gmail API (which takes precedence over SMTP) is disabled in dev
GMAIL_USER_EMAIL=
GMAIL_CLIENT_ID=
GMAIL_REFRESH_TOKEN=
