# Variables du mode développement local (aucun secret, vérifiées par dev/check_env.py) — chargées par dev/run_server.sh
# et à sourcer avant dev/seed/seed_emulator.py :  set -a && source dev/dev.env && set +a
ALJ_ENV=dev
ALJ_API_AUTH=off
MEMBER_BACKEND=firestore
ALJ_DATA_DIR=./data-dev
FIRESTORE_EMULATOR_HOST=localhost:8081
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# E-mails : SMTP de l'application dirigé vers Mailpit (dev/docker-compose.yml), rien ne sort
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dev
SMTP_PASSWORD=dev
SMTP_FROM_EMAIL=bureau@poudlard.example
# Vides volontairement : l'API Gmail (prioritaire sur le SMTP) est désactivée en dev
GMAIL_USER_EMAIL=
GMAIL_CLIENT_ID=
GMAIL_REFRESH_TOKEN=
